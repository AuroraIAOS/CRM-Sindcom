# CRM Sindcom — SPA fallback + cache (Hostgator / Apache)
# Copiado para dist/ no build (Vite serve o publicDir como raiz).

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # HTTPS obrigatório. Precisa vir ANTES do fallback de SPA: se o fallback rodar
  # primeiro, a requisição termina em index.html e nunca chega aqui, e o app é
  # entregue em texto claro. Quem digita o endereço sem "https://" recebe hoje o
  # HTML e o JavaScript por canal aberto — e é o JavaScript que fala com o
  # Supabase, o que dá a um atacante na rede a chance de trocá-lo.
  # As duas condições cobrem acesso direto (%{HTTPS}) e o dia em que um CDN ou
  # proxy entrar na frente (X-Forwarded-Proto). Hoje não há proxy: medido.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Arquivos e diretórios reais são servidos direto.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Qualquer outra rota do SPA → index.html (React Router resolve no cliente).
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # HSTS — instrui o navegador a nunca mais tentar HTTP neste host.
  # `env=HTTPS` restringe o cabeçalho às respostas servidas por TLS: enviá-lo em
  # resposta HTTP é inócuo, mas a especificação manda ignorá-lo, e mantê-lo no
  # lugar certo evita leitura errada em auditoria.
  #
  # max-age deliberadamente curto (1 dia) nesta primeira aplicação. HSTS é um
  # compromisso que o navegador guarda: se algo quebrar no TLS, não há como
  # voltar atrás dentro da janela já distribuída. Elevar para 31536000 (1 ano)
  # depois de uma semana com o redirecionamento estável.
  # `includeSubDomains` fica FORA de propósito — alcançaria envios.sindcompassos.org
  # e qualquer subdomínio futuro, que não têm relação com este servidor.
  Header always set Strict-Transport-Security "max-age=86400" env=HTTPS

  # Assets com hash no nome podem ser cacheados por muito tempo.
  <FilesMatch "\.(js|css|woff2?|png|jpg|jpeg|svg|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # index.html e service worker nunca em cache (bloco por último = sobrepõe o
  # de assets para sw.js/registerSW.js, que também terminam em .js).
  <FilesMatch "(index\.html|sw\.js|registerSW\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
