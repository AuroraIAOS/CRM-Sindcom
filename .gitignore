# ============================================
# CRM SINDCOM — .gitignore
# ============================================

# Dependências
node_modules/

# Builds
dist/
dist-ssr/
build/

# Ambiente — NUNCA versionar chaves
.env
.env.*
!.env.example

# PWA / Vite
*.local
.vite/

# Testes e cobertura
coverage/
*.lcov

# Supabase CLI (se usado localmente)
supabase/.temp/
supabase/.branches/

# Logs
logs/
*.log
npm-debug.log*

# Sistema operacional
.DS_Store
Thumbs.db
desktop.ini

# Editores
.vscode/*
!.vscode/extensions.json
.idea/


# ============================================================
# SEGREDOS — NUNCA COMMITAR (blindagem reforçada)
# ============================================================

# Dados sensíveis de teste — CSVs e XLS com dados reais JAMAIS entram no repo
dados/
*.csv
!docs/**/*.csv
*.xls
*.xlsx

# Termos sensíveis (qualquer arquivo que contenha estas palavras no nome)
*credencial*
*credenciais*
*credential*
*credentials*
*secret*
*secrets*
*senha*
*senhas*
*password*
*passwords*
*chave*
*chaves*

# Arquivos de chave / certificado / token
*.key
*.pem
*.pfx
*.p12
*.token
*token*.json
service-account*.json
*serviceaccount*.json

# ============================================================
# Node
# ============================================================
node_modules/
npm-debug.log*
yarn-error.log*
dist/
build/

# ============================================================
# Sandbox / temporários
# ============================================================
sandbox/
/tmp/
*.tmp
.cache/

# ============================================================
# n8n exports temporários
# ============================================================
*.n8n.tmp
