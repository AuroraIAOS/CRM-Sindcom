      "id": "3319ce12-1e97-4c9a-ab4f-9d30111aaf8d",
      "name": "Buscar mensagens (getUpdates)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -688,
        128
      ]
    },
    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nconst resp = $input.first().json;\nconst updates = resp.result || [];\nlet maxId = staticData.lastUpdateId ?? -1;\nconst saida = [];\nfor (const u of updates) {\n  if (u.update_id > maxId) maxId = u.update_id;\n  const msg = u.message;\n  if (!msg || !msg.text) continue;\n  const chatId = msg.chat.id;\n  const texto = msg.text.trim();\n  const digitos = texto.replace(/\\D/g, '');\n  const match = digitos.match(/\\d{11}/);\n  saida.push({ json: { chat_id: chatId, texto_original: texto, cpf: match ? match[0] : null } });\n}\nstaticData.lastUpdateId = maxId;\nreturn saida;"
      },
      "id": "66606911-ce99-4232-a522-252a3b5b8f98",
      "name": "Extrair mensagens de texto",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
