    },
    {
      "parameters": {
        "url": "https://api.telegram.org/bot<<SUBSTITUIR: TELEGRAM_HTTP_API>>/getUpdates",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "offset",
              "value": "={{ $json.offset }}"
