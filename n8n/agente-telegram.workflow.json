      "id": "2256a570-1448-4eff-bb3d-22fcc20e969d",
      "name": "Consultar fn_consulta_nivel_bloqueio",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const texto = 'Olá! Sou o Arthur, assistente do Sindcom. Envie seu CPF (formatado ou só números) para consultar seu nível de proteção e situação de bloqueio.';\nreturn { json: { chat_id: $json.chat_id, texto_resposta: texto } };"
      },
      "id": "cf5f912e-8b75-44da-b608-e4306cfe5550",
      "name": "Formatar mensagem de ajuda",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        240
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const r = $json;\nconst chatId = $('Extrair mensagens de texto').item.json.chat_id;\nlet texto;\nif (!r.encontrado) {\n  texto = 'Não encontramos esse CPF em nossa base de filiados. Confira os números e tente de novo, ou fale com a secretaria.';\n} else {\n  const saudacao = r.primeiro_nome ? ('Olá, ' + r.primeiro_nome + '! ') : 'Olá! ';\n  const nomesNivel = { bronze: 'Bronze', prata: 'Prata', ouro: 'Ouro' };\n  const nivelTexto = nomesNivel[r.nivel] || r.nivel;\n  const linhas = [saudacao + 'Seu nível de proteção é ' + nivelTexto + '.'];\n  linhas.push('Situação do cadastro: ' + r.status_cadastro + '.');\n  if (r.nivel !== 'bronze') {\n    linhas.push(r.bloqueado_contribuicao\n      ? 'Atenção: contribuição sindical em atraso — pode haver bloqueio de benefícios.'\n      : 'Contribuição sindical em dia.');\n  }\n  if (r.nivel === 'ouro') {\n    linhas.push(r.bloqueado_mensalidade\n      ? 'Atenção: mensalidade do convênio em atraso.'\n      : 'Mensalidade do convênio em dia.');\n  }\n  texto = linhas.join('\\n');\n}\nreturn { json: { chat_id: chatId, texto_resposta: texto } };"
      },
      "id": "4f1de1fc-0a3c-4759-8221-ac4bfc85cb4f",
      "name": "Formatar resposta da consulta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
