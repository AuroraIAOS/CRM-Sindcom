      "id": "78bf6f15-8148-4b53-9225-39033c403e44"
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "const item = $input.item.json;\nconst FALLBACK = 'secretaria@sindcompassos.org';\nconst destino = item.email_destino || FALLBACK;\nconst linhas = (item.faturas || []).map(f =>\n  `<tr><td>${f.trabalhador}</td><td>${f.tipo}</td><td style=\"text-align:right\">R$ ${Number(f.valor).toFixed(2)}</td></tr>`\n).join('');\nconst html = `<!DOCTYPE html><html><head><meta charset=\"utf-8\"><style>\nbody{font-family:Arial,sans-serif;font-size:13px;color:#222;padding:24px}\nh1{font-size:18px;margin-bottom:4px}\ntable{width:100%;border-collapse:collapse;margin-top:16px}\ntd,th{border:1px solid #ccc;padding:6px 8px;text-align:left}\n.total{font-weight:bold;margin-top:12px;font-size:14px}\n</style></head><body>\n<h1>Guia de pagamento ${item.numero_guia_pagamento}</h1>\n<p><strong>Empresa:</strong> ${item.empresa}<br/>\n<strong>Tipo:</strong> ${item.tipo}<br/>\n<strong>Competência:</strong> ${item.competencia}<br/>\n<strong>Vencimento:</strong> ${item.data_vencimento}</p>\n<table><thead><tr><th>Trabalhador</th><th>Tipo</th><th>Valor</th></tr></thead>\n<tbody>${linhas}</tbody></table>\n<p class=\"total\">Total: R$ ${Number(item.valor_total).toFixed(2)} (${item.qtd_faturas} fatura(s))</p>\n</body></html>`;\nreturn { repasse_id: item.repasse_id, numero_guia_pagamento: item.numero_guia_pagamento, tipo: item.tipo, competencia: item.competencia, valor_total: item.valor_total, empresa: item.empresa, destino_resolvido: destino, html };"
      },
      "name": "Montar HTML da guia",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        110
      ],
      "id": "1717561f-fae9-47e5-b451-2f97d9fe5661"
    },
    {
      "parameters": {
        "operation": "toBinary",
        "sourceProperty": "html",
        "options": {
          "fileName": "index.html",
          "mimeType": "text/html"
        }
      },
      "name": "Converter para arquivo",
      "type": "n8n-nodes-base.convertToFile",
      "typeVersion": 1.1,
      "position": [
