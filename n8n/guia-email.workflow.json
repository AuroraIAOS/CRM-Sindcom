      ],
      "id": "96cd3c57-b38e-4da8-82bb-62c395a3fcdf"
    },
    {
      "parameters": {
        "fromEmail": "sindcompassos@gmail.com",
        "toEmail": "={{$node[\"Montar HTML da guia\"].json[\"destino_resolvido\"]}}",
        "subject": "=Guia de pagamento {{$node[\"Montar HTML da guia\"].json[\"numero_guia_pagamento\"]}} — Sindcom Passos",
        "emailFormat": "html",
        "html": "=<p>Segue em anexo a guia de pagamento <strong>{{$node[\"Montar HTML da guia\"].json[\"numero_guia_pagamento\"]}}</strong>, referente a {{$node[\"Montar HTML da guia\"].json[\"tipo\"]}}, competência {{$node[\"Montar HTML da guia\"].json[\"competencia\"]}}.</p><p>Empresa: {{$node[\"Montar HTML da guia\"].json[\"empresa\"]}}<br/>Valor total: R$ {{$node[\"Montar HTML da guia\"].json[\"valor_total\"]}}</p><p>Sindicato dos Empregados no Comércio de Passos e Região</p>",
        "options": {
          "attachments": "data",
          "replyTo": "secretaria@sindcompassos.org"
        }
      },
      "name": "Enviar e-mail",
      "type": "n8n-nodes-base.emailSend",
