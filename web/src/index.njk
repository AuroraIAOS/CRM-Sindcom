        <ul class="nivel__linhas">
          <li><svg class="ic" aria-hidden="true"><use href="#i-pessoa"/></svg>Sindicalizado</li>
          <li><svg class="ic" aria-hidden="true"><use href="#i-balanca"/></svg>Direito Coletivo + Individual</li>
          <li><svg class="ic" aria-hidden="true"><use href="#i-moeda"/></svg>Contribuição Sindical</li>
          <li><svg class="ic" aria-hidden="true"><use href="#i-pessoa"/></svg>Titular</li>
