          <li><svg class="ic" aria-hidden="true"><use href="#i-balanca"/></svg>Direito Coletivo</li>
          <li><svg class="ic" aria-hidden="true"><use href="#i-moeda"/></svg>Sem custo</li>
          <li><svg class="ic" aria-hidden="true"><use href="#i-pessoa"/></svg>Titular</li>
        </ul>
      </article>
      <article class="nivel" data-revelar>
        {% imagem "Sindcom-Sindicalizado-Prata.png", "Selo do nível Prata, trabalhador sindicalizado", "96px", "nivel__selo", false %}
