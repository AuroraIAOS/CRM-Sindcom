          <li class="sim"><span class="sr">Inclui: </span>Reajustes salariais</li>
          <li class="sim"><span class="sr">Inclui: </span>Proteção coletiva</li>
          <li class="sim"><span class="sr">Inclui: </span>Convenções coletivas</li>
          <li class="sim"><span class="sr">Inclui: </span>Homologação</li>
          <li class="sim"><span class="sr">Inclui: </span>Assistência sindical individual</li>
          <li class="sim"><span class="sr">Inclui: </span>Assistência jurídica individual</li>
